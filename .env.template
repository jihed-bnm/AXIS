# ──────────────────────────────────────────────────────────────────────────────
# AXIS Platform — Environment Variables Template
# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Credentials used by both the postgres container and the backend service.
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=erp_db

# ── JWT Authentication ─────────────────────────────────────────────────────────
# SECRET_KEY must be a long random string (≥32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_use_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── SMTP (email notifications) ────────────────────────────────────────────────
# Use an app-specific password, not your account password.
SMTP_EMAIL=your_email@example.com
SMTP_APP_PASSWORD=your_app_specific_password

# ── ChromaDB (Docker-internal) ────────────────────────────────────────────────
# Points to the axis-chromadb service inside the Docker network.
# Change only if you run chromadb on a different host/port.
CHROMADB_URL=http://axis-chromadb:8001

# ── Ollama LLM runtime (Docker-internal) ──────────────────────────────────────
# Points to the axis-ollama service inside the Docker network.
# Change only if you run Ollama on a different host/port.
OLLAMA_BASE_URL=http://axis-ollama:11434

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
